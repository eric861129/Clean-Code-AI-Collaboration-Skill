    {
      "id": "react-overdue-rule",
      "language": "typescript-react",
      "fixture_path": "fixtures/react-overdue-rule",
      "evaluator_path": "evaluators/react-overdue-rule",
      "task": "調整 High Priority 工作項目的逾期規則：到期後保留兩小時寬限，剛好到達兩小時邊界時才視為逾期。請保留其他既有行為與公開 UI Contract，完成後執行 Repository Gate。",
      "must_preserve": [
        "Normal Priority 到期時仍視為逾期",
        "Completed Work Item 永遠不進入逾期清單",
        "WorkItemList Props 與顯示 Contract",
        "與逾期規則無關的 Render 行為"
      ],
      "allowed_diff": [
        "src/overdue.ts",
        "src/overdue.public.test.tsx",
        "src/overdue.test.ts",
        "src/overdue.test.tsx"
      ],
      "allowed_diff_patterns": [
        "^src/overdue(?:[.][A-Za-z0-9_-]+)?[.]tsx?$"
      ],
      "prohibited_changes": [
        "不得修改 package.json、package-lock.json 或工具鏈設定",
        "不得改變 WorkItemList Props 或建立第二套 WorkItem Model"
      ],
      "commands": {
        "public": [
          ["npm", "test", "--", "src/overdue.public.test.tsx"],
          ["npm", "run", "typecheck"],
          ["npm", "run", "lint"]
        ],
        "preservation": [
          ["npm", "test", "--", ".benchmark-oracle/preservation.test.tsx"]
        ],
        "acceptance": [
          ["npm", "test", "--", "--reporter=verbose", ".benchmark-oracle/acceptance.test.ts"]
        ]
      },
      "expected_baseline_red_markers": [
        "is not overdue one minute before the two-hour boundary",
        "is overdue exactly at the two-hour boundary"
      ],
      "expected_baseline_failure_count": 1
    },
